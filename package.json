{
  "name": "learn-ai",
  "version": "0.1.0",
  "description": "Learn AI through evolutionary biology and ecology: daily 30-minute modules, offline-capable PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-data.mjs && vite",
    "build": "node scripts/prepare-data.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "data": "node scripts/prepare-data.mjs",
    "narrate": ".venv/bin/python learn-ai-rag/scripts/narrate.py course/narration public/audio",
    "validate": "node scripts/validate-course.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
